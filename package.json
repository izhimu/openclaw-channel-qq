{
  "name": "@izhimu/openclaw-channel-qq",
  "version": "1.0.0",
  "description": "A QQ channel plugin for OpenClaw using NapCat WebSocket",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "qq"
  ],
  "author": "izhimu",
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@izhimu/openclaw-channel-qq",
      "localPath": "extensions/qq",
      "defaultChoice": "npm"
    }
  },
  "peerDependencies": {
    "openclaw": "^2026.2.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "openclaw": "^2026.2.1",
    "typescript": "^5.0.0"
  }
}
